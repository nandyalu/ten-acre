# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Runtime data: live trading DB, webull tokens/state — not source, and
# data/webull holds an actual exchanged access token.
data/

# The built Angular bundle, where backend/app.py looks for it (_WEB_DIR).
# angular.json's outputPath writes it here directly, in a checkout and in the
# Dockerfile's build stage alike. A build output, not source.
backend/web/

# Webull SDK's default token-cache location when WEBULL_OPENAPI_TOKEN_DIR
# isn't set (e.g. running locally outside the container) — holds a live
# exchanged auth token, same reason as data/webull/ above.
conf/

# Python
.venv/
# `uv build` output: the two wheels and the constraints file a release ships.
/dist/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
uv-cache/

# Build artifacts — regenerated by the Docker build stages, not source.
# backend/site is the docs build, where zensical.toml's site_dir puts it and
# backend/app.py serves it from (_SITE_DIR).
backend/site/
frontend/dist/
frontend/node_modules/
frontend/.angular/

# Docs site build cache
.cache/

# Local-only Claude Code settings (personal permission config, not shared).
.claude/settings.local.json
# The handoff skill's notes between two sessions, one file for each topic. Personal and short-lived.
.claude/handoffs/
# Token and cache totals for each Claude Code session, written by .claude/helpers/session-usage.py.
.claude/usage/

# OS/editor
.DS_Store

# Deployed-stack compose files — local only, not tracked.
dockge/

# The Ollama pool's own stack, plus the model benchmark harness under
# ollama-stack/bench/. Both are specific to this machine — seven named
# containers, their docker-bridge IPs, and 8 GiB cards — so neither would run
# anywhere else. What the benchmarks *found*, and the method traps that apply
# to any rig, are in ollama/README.md, which is tracked.
ollama-stack/

# Working notes, kept locally and out of the published repo. Each was
# superseded by JOURNEY.md, which records what changed and why rather than
# what somebody intended to do next.
# All four are deleted, not merely untracked. Anything in them that was still
# true moved into CLAUDE.md or JOURNEY.md first; the rest was a plan for work
# that is finished. They stay listed so a stray copy never lands back here.
#   ROADMAP.md                 — described the app before the 2026-09-01 reset
#   plan.md                    — the website rebuild, finished
#   PLAN-autonomous-analyst.md — built and running since 2026-09-01
#   helpful-prs.md             — all eight PRs merged and cherry-picked
ROADMAP.md
plan.md
PLAN-*.md
helpful-prs.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Scratch dumps of a built prompt, for a one-off before/after comparison.
# The record of a real prompt is the AgentRun row it was built for, and
# JOURNEY.md holds why it changed — these are neither.
/prompt.md
/prompt_updated.md
